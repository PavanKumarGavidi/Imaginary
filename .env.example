# Copy this file to .env.local and fill in your Supabase project keys.
# Supabase → Project Settings → API → Project URL / anon public key
#
# When both are set, the site runs in CLOUD MODE:
#   · real email/password auth for the staff desk
#   · bookings, reviews, team & gallery stored in Supabase (RLS protected)
# Leave them empty to run in LOCAL DEMO MODE (browser storage, admin / imagine24).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── On-site Stripe deposit payments ──────────────────────────────
# Stripe dashboard → Developers → API keys → "Publishable key" (starts with pk_)
# This key is SAFE to expose in the browser. The secret key (sk_) goes only in
# Supabase Edge Function secrets — never here.
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Booking email notifications (optional · EmailJS free tier: 200 emails/mo) ──
# 1. emailjs.com → Email Services → add your inbox (Gmail/Outlook/SMTP) → copy SERVICE ID
# 2. Email Templates → create the two templates from README → copy their IDs
# 3. Account → API keys → copy the PUBLIC KEY
# Leave empty to skip email notifications (bookings still work).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_STUDIO_TEMPLATE_ID=
VITE_EMAILJS_CLIENT_TEMPLATE_ID=

# ── Google Analytics 4 (optional) ──
# 1. Go to https://analytics.google.com → Admin → Data Streams → Add stream → Web
# 2. Copy the Measurement ID (starts with G-)
# Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# ── Google Search Console Verification (optional) ──
# 1. Go to https://search.google.com/search-console → Add property
# 2. Choose "URL prefix" method → enter your domain
# 3. Select "HTML tag" verification method → copy the meta tag content
# Paste the content value here (the long string after content="...")
# Leave empty to skip verification.
VITE_GSC_VERIFICATION=
